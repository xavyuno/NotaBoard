[gd_scene format=3 uid="uid://6o4wmbovw3tg"]

[sub_resource type="GDScript" id="GDScript_cwixq"]
script/source = "extends Control

var Data := {}

func _ready() -> void:
	User.DragSelecting = false
	Data = User.TodoData
	get_node(\"CheckList/Text\").text = Data[\"Text\"]
	get_node(\"CheckList/Input\").button_pressed = Data[\"Value\"]

func _physics_process(delta: float) -> void:
	if Input.is_action_just_released(\"Click\"):
		User.MovingTodo = false
	if User.MovingTodo:
		global_position = get_global_mouse_position()
	else:
		queue_free()
"

